# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Secrets — never commit
.env
.env.*
!.env.example

# Local MLflow store (sqlite + artifacts)
.mlflow/

# Scratch working directory for the optimiser
workspace/

# tau2-bench simulation output written by the upstream CLI (our runs/ is the record)
data/simulations/

# Node / frontend
node_modules/
frontend/dist/

# OS / editor
.DS_Store

# tau2's own dotenv and per-call LLM logs (workspace/ already covers the SDK cwd)
vendor/tau2-bench/.env
llm_logs/
workspace_smoke.log

# Terraform
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.backup
infra/terraform/**/.terraform.lock.hcl

# local embedding vectors and model caches (eval/retrieval.py)
.cache/

# s21: a concurrent workflow_rag build's live locks (the commit log beside them is kept)
rag_library/*/*/locks.json
rag_library/*/*/library.lock
rag_library/*/*/build.lock
rag_library/*/*/.*.tmp
