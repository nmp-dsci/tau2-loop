# Copy to .env. Never commit .env.
#
# Billing is the subscription: leave ANTHROPIC_API_KEY unset (or blank) and be
# logged in to the Claude CLI (`claude login`). The runner refuses to start if
# both a key and BILLING=subscription are present, so a per-token bill cannot
# happen by accident. A key that tau2's dotenv search finds in ~/.env is
# scrubbed at start-up (see llm.scrub_injected_key).
BILLING=subscription
# ANTHROPIC_API_KEY=

# Central MLflow (nmp-central-ai; `make platform-up`). The old sqlite store under .mlflow/ is an archive.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DISABLE_AGENT_HINT=1

# Central Postgres (nmp-central-ai, database `tau2`; `make -C ../nmp-central-ai db-init`
# prints these). App state only — reviews and submission records; every benchmark fact
# stays a committed file, and the viewer serves read-only with this stopped.
PG_SUPERUSER_URL=postgresql://nmp:nmp@localhost:5432/tau2
DATABASE_URL=postgresql://tau2_owner:tau2_owner@localhost:5432/tau2
RO_DATABASE_URL=postgresql://tau2_ro:tau2_ro@localhost:5432/tau2
