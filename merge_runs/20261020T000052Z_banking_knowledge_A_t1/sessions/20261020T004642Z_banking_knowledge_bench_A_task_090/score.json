    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "Reported within 2 business days of statement: Maximum liability $50",
    "doc": "doc_bank_accounts_bank_accounts_(general)_031",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "For fraud disputes over $500, ask if customer has filed a police report. If not, recommend they do so.",
