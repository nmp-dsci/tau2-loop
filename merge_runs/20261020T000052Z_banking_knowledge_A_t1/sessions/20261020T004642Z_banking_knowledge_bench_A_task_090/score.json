   {
    "quote": "When a customer needs to file a dispute for a debit card transaction (unauthorized charges, ATM errors, merchant issues, or incorrect amounts), the agent must gather comprehensive information and follow Regulation E requirements.",
    "doc": "doc_bank_accounts_bank_accounts_(general)_031",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "If unauthorized transactions found: File dispute, close card, order replacement.",
    "doc": "doc_bank_accounts_bank_accounts_(general)_041",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_041",
    "found": true,
    "long": false
   },
   {
    "quote": "ID of the transaction being disputed. Use get_bank_account_transactions_9173 to find it.",
    "doc": "doc_bank_accounts_bank_accounts_(general)_031",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "Dispute the earliest (first) transaction when multiple duplicates exist.",
    "doc": "doc_bank_accounts_bank_accounts_(general)_031",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "To retrieve a customer's debit card dispute history and check the status of open disputes, use the get_debit_dispute_status_7483 tool.",
    "doc": "doc_bank_accounts_bank_accounts_(general)_035",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_035",
    "found": true,
    "long": false
   },
   {
    "quote": "Transaction must be within 60 days old",
    "doc": "doc_bank_accounts_bank_accounts_(general)_031",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "Customer cannot exceed the maximum open disputes for their checking account tier: Entry Tier max 2, Mid Tier max 3, Premium Tier max 4, Elite Tier max 5. Dispute limits are per account, not per customer.",
    "doc": "doc_bank_accounts_bank_accounts_(general)_031",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "The debit card must be linked to an OPEN checking account",
    "doc": "doc_bank_accounts_bank_accounts_(general)_031",
    "doc_id": "doc_bank_accounts_bank_accounts_(general)_031",
    "found": true,
    "long": false
   },
   {
    "quote": "- PREMIUM TIER (Evergreen Account)",
